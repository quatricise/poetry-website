mult":0.95,"maxOpacity":0.5,"opacity":0.5,"glowUnderCursor":false,"visible":false,"selected":false,"animation":{"frames":[],"frameProgress":0,"frameDuration":60,"playing":false,"currentFrameNum":0,"framesTotal":0},"animated":false,"filter":null,"chainlink":false,"objectType":"img"},{"id":"s13pressedhand","dimX":747,"dimY":747,"x":559,"y":9525,"hidden":false,"rotation":0,"src":"assets/s13_pressed_her_hand.png","img":{},"shadow":null,"ctx":{},"mult":0.95,"maxOpacity":1,"opacity":1,"glowUnderCursor":false,"visible":false,"selected":false,"animation":{"frames":[],"frameProgress":0,"frameDuration":60,"playing":false,"currentFrameNum":0,"framesTotal":0},"animated":false,"filter":null,"chainlink":false,"objectType":"img"},{"id":"text_author","x":745,"y":-443,"hidden":false,"text":[[-50,-100],"John Keats"],"ctx":{},"mult":1,"font":"40px andada","visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"poem_title","x":745,"y":-393,"hidden":false,"text":[[-50,-50],"Hyperion, Book I"],"ctx":{},"mult":1,"font":"80px andada","visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s1","x":744,"y":429,"hidden":false,"text":[[744,429],"Deep in the shady sadness of a vale","Far sunken from the healthy breath of morn,","Far from the fiery noon, and eve's one star,","Sat gray-hair'd Saturn, quiet as a stone,"],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s2","x":1522,"y":1157,"hidden":false,"text":[[1522,1157],"Still as the silence round about his lair;","Forest on forest hung about his head"],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s3","x":812,"y":1698,"hidden":false,"text":[[812,1698],"Like cloud on cloud. No stir of air was there,","Not so much life as on a summer's day"],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s4","x":1305,"y":2160,"hidden":false,"text":[[1305,2160],"Robs not one light seed from the feather'd grass,","But where the dead leaf fell, there did it rest.","A stream went voiceless by, still deadened more","By reason of his fallen divinity"],"ctx":{},"mult":1,"visible":true,"selected":false,"objectType":"textObject","playing":false},{"id":"s5","x":401,"y":2980,"hidden":false,"text":[[805,2777],"Spreading a shade: the Naiad 'mid her reeds","Press'd her cold finger closer to her lips."],"ctx":{},"mult":1,"visible":true,"selected":true,"objectType":"textObject","playing":false},{"id":"s6","x":1410,"y":2978,"hidden":false,"text":[[1410,2978],"Along the margin-sand large foot-marks went,","No further than to where his feet had stray'd,","And slept there since. Upon the sodden ground","His old right hand lay nerveless, listless, dead,"],"ctx":{},"mult":1,"visible":true,"selected":false,"objectType":"textObject","playing":false},{"id":"s7","x":700,"y":3509,"hidden":false,"text":[[700,3509],"Unsceptred; and his realmless eyes were closed;","While his bow'd head seem'd list'ning to the Earth,","His ancient mother, for some comfort yet."],"ctx":{},"mult":1,"visible":true,"selected":false,"objectType":"textObject","playing":false},{"id":"s8","x":1123,"y":4000,"hidden":false,"text":[[1123,4000],"It seem'd no force could wake him from his place;","But there came one, who with a kindred hand","Touch'd his wide shoulders, after bending low","With reverence, though to one who knew it not."],"ctx":{},"mult":1,"visible":true,"selected":false,"objectType":"textObject","playing":false},{"id":"s9","x":1138,"y":4602,"hidden":false,"text":[[1138,4602],"She was a Goddess of the infant world;","By her in stature the tall Amazon","Had stood a pigmy's height; she would have ta'en","Achilles by the hair and bent his neck;","Or with a finger stay'd Ixion's wheel."],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s10","x":1754,"y":5297,"hidden":false,"text":[[1754,5297],"Her face was large as that of Memphian sphinx,","Pedestal'd haply in a palace court,","When sages look'd to Egypt for their lore."],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s11","x":1410,"y":5812,"hidden":false,"text":[[1410,5812],"But oh! how unlike marble was that face:","How beautiful, if sorrow had not made","Sorrow more beautiful than Beauty's self."],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s12","x":1123,"y":6000,"hidden":false,"text":[[1123,6000],"There was a listening fear in her regard,","As if calamity had but begun;","As if the vanward clouds of evil days","Had spent their malice, and the sullen rear","Was with its stored thunder labouring up."],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s13","x":1123,"y":6500,"hidden":false,"text":[[1123,6500],"One hand she press'd upon that aching spot","Where beats the human heart, as if just there,","Though an immortal, she felt cruel pain:"],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s14","x":1123,"y":7000,"hidden":false,"text":[[1123,7000],"The other upon Saturn's bended neck","She laid, and to the level of his ear","Leaning with parted lips, some words she spake","In solemn tenour and deep organ tone:"],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s15","x":1123,"y":7000,"hidden":false,"text":[[1123,7000],"Some mourning words, which in our feeble tongue","Would come in these like accents; O how frail","To that large utterance of the early Gods!","\"Saturn, look up!—though wherefore, poor old King?"],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s16","x":1123,"y":7000,"hidden":false,"text":[[1123,7000],"I have no comfort for thee, no not one:","I cannot say, \"O wherefore sleepest thou?\"","For heaven is parted from thee, and the earth","Knows thee not, thus afflicted, for a God;"],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"s17","x":0,"y":0,"hidden":false,"text":[[0,0],"And ocean too, with all its solemn noise,","Has from thy sceptre pass'd; and all the air","Is emptied of thine hoary majesty.","Thy thunder, conscious of the new command,"],"ctx":{},"mult":1,"visible":false,"selected":false,"objectType":"textObject","playing":false},{"id":"chaintest","dimX":64,"dimY":64,"x":923,"y":618,"hidden":false,"rotation":0,"src":"http://127.0.0.1:5500/assets/chainlink_circle_large.png","img":{},"shadow":null,"ctx":{},"mult":0.95,"maxOpacity":0,"opacity":0.9330127018922199,"glowUnderCursor":false,"visible":false,"selected":false,"animation":{"frames":[],"frameProgress":0,"frameDuration":60,"playing":false,"currentFrameNum":0,"framesTotal":0},"animated":false,"filter":null,"chainlink":true,"objectType":"img"},{"id":"chaintest2","dimX":64,"dimY":64,"x":952,"y":695,"hidden":false,"rotation":0,"src":"http://127.0.0.1:5500/assets/chainlink_circle_small.png","img":{},"shadow":null,"ctx":{},"mult":0.95,"maxOpacity":0,"opacity":0.9330127018922199,"glowUnderCursor":false,"visible":false,"selected":false,"animation":{"frames":[],"frameProgress":0,"frameDuration":60,"playing":false,"currentFrameNum":0,"framesTotal":0},"animated":false,"filter":null,"chainlink":true,"objectType":"img"},{"id":"chaintest2990265630","dimX":64,"dimY":64,"x":1008,"y":731,"hidden":false,"rotation":0,"src":"http://127.0.0.1:5500/assets/chainlink_circle_small.png","img":{},"shadow":null,"ctx":{},"mult":0.95,"maxOpacity":0,"opacity":0.9330127018922199,"instanceOf":"chaintest2","glowUnderCursor":false,"visible":false,"selected":false,"animation":{"frames":[],"frameProgress":0,"frameDuration":60,"playing":false,"currentFrameNum":0,"framesTotal":0},"animated":false,"filter":null,"chainlink":true,"objectType":"img"},{"id":"chaintest2569922288","